<?xml version="1.0" encoding="utf-8"?>
<!--
  RAV Agent Universal MSI with Full GUI Wizard
  
  Flow: Welcome -> EULA -> Enrollment Config -> Install
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  
  <Package Name="RAV Monitoring Agent"
           Manufacturer="RAV Security"
           Version="2.0.7.0"
           UpgradeCode="E8D1E3C0-4B5F-4D3E-8A72-1234567890AB"
           Scope="perMachine">
    
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- INSTALL-TIME PROPERTIES -->
    <Property Id="BACKEND_URL" Value="http://172.16.100.41" Secure="yes" />
    <Property Id="ENROLLMENT_TOKEN" Secure="yes" />
    <Property Id="SCREENSHOT_INTERVAL" Value="60" /> <!-- Default 1 minute -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- License file -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Use FeatureTree UI which is simpler -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    
    <!-- Optional Reboot: Show checkbox on exit dialog -->
    <!-- When checked, Windows Installer will prompt for reboot -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Restart now to enable all monitoring features (recommended)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" /> <!-- Checked by default -->
    
    <InstallExecuteSequence>
        <!-- Before any file swap, kill the USER-SESSION agent processes (helper + native host)
             so they don't hold the old exe open. Without this, a rename/upgrade can't delete the
             loaded old exe and Windows defers a system reboot. Session-filtered (SESSION ne 0) so
             the session-0 service is left to ServiceControl, not force-killed. Runs early, every
             install/upgrade/uninstall; harmless when no such process exists. -->
        <Custom Action="KillUserSessionAgents" After="InstallInitialize" />
        <ScheduleReboot After="InstallFinalize" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1" />
        <!-- Patch native host JSON with real install path after files are copied -->
        <Custom Action="PatchNativeHostManifest" After="InstallFiles" />
        <!-- Install / remove the watchdog Scheduled Task (runs every 5 min as
             SYSTEM, independently of the main service, so it keeps reporting
             when the service is dead or removed). -->
        <Custom Action="InstallWatchdogTask" After="InstallFiles" Condition="NOT REMOVE" />
        <Custom Action="RemoveWatchdogTask" Before="RemoveFiles" Condition="REMOVE" />
        <!-- No antivirus exclusions. This agent is code-signed, so Defender /
             SmartScreen accept it on reputation; we never add Defender
             exclusions or touch Tamper Protection. On Smart App Control boxes,
             deploy via Intune/GPO (see deployment/SIGNING-AND-CLEAN-INSTALL.md).
             We never instruct operators to disable any protection. -->
    </InstallExecuteSequence>
    
    
    <!-- Custom UI elements -->
    <UI>
      <!-- Enrollment dialog -->
      <Dialog Id="EnrollmentDlg" Width="370" Height="270" Title="RAV Agent - Organization Enrollment">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Organization Enrollment" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes" Text="Connect this agent to your organization." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        
        <Control Id="ServerLabel" Type="Text" X="20" Y="56" Width="330" Height="15" NoPrefix="yes" Text="Server address (from your IT administrator):" />
        <Control Id="ServerEdit" Type="Edit" X="20" Y="71" Width="330" Height="18" Property="BACKEND_URL" />

        <Control Id="TokenLabel" Type="Text" X="20" Y="98" Width="330" Height="15" NoPrefix="yes" Text="Enrollment Token (from your IT administrator):" />
        <Control Id="TokenEdit" Type="Edit" X="20" Y="113" Width="330" Height="18" Property="ENROLLMENT_TOKEN" />

        <Control Id="InfoText" Type="Text" X="20" Y="143" Width="330" Height="50" NoPrefix="yes" Text="Both values are provided by your IT administrator. The server address is where this agent reports (e.g. http://your-server-ip); the enrollment token links it to your organization's monitoring dashboard." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="CustomizeDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      
      <!-- Wire up the dialog flow: License -> Enrollment -> Customize -->
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="EnrollmentDlg" Order="3" />
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="EnrollmentDlg" Order="3" />
    </UI>

    <!-- Install directory structure -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RAV Monitoring Agent">
        <Component Id="MainExecutable" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890" Bitness="always64">
          <File Id="AgentExe" Source="$(var.AgentPath)\RavMonitor.exe" KeyPath="yes" />
          <File Id="AgentNativeHostBat" Source="rav-native-host.bat" />
          <File Id="LaunchHelperVbs" Source="launch-helper.vbs" />
          <!-- Internal service key (Name) kept stable as "AssetTelemetryService" for upgrade
               continuity; the DisplayName/Description are honest about what the agent does. -->
          <ServiceInstall Id="RAVAgentService" Name="AssetTelemetryService" DisplayName="RAV Monitoring Agent" Description="Monitors and records user activity (screen, browsing, USB devices, and applications) on this company-managed device for the employer. Deployed and managed by IT." Start="auto" Type="ownProcess" ErrorControl="normal" Account="LocalSystem">
            <!-- Auto-restart the service if it ever terminates unexpectedly (crash). NOTE: a
                 clean Stop is not a "failure" and will NOT trigger this — so this is insurance
                 against crashes, not a substitute for the Interrogate handler fix. -->
            <util:ServiceConfig FirstFailureActionType="restart"
                                SecondFailureActionType="restart"
                                ThirdFailureActionType="restart"
                                RestartServiceDelayInSeconds="60"
                                ResetPeriodInDays="1" />
          </ServiceInstall>
          <ServiceControl Id="StartRAVService" Name="AssetTelemetryService" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          
          <!-- Registry key to launch helper on user logon (HKCU, runs in user session) -->
          <!-- Uses wscript to run the VBS launcher silently (no console window) -->
          <RegistryValue Root="HKCU" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="RAVScreenshotHelper" Value="wscript.exe &quot;[INSTALLFOLDER]launch-helper.vbs&quot;" Type="string" />
          
          <!-- Native Messaging Host registration -->
          <File Id="NativeHostManifestChrome" Source="native-messaging-host.json" Name="com.rav.agent.json" />
          
          <!-- Chrome Native Messaging (HKLM) -->
          <RegistryValue Root="HKLM" Key="SOFTWARE\Google\Chrome\NativeMessagingHosts\com.rav.agent" Value="[INSTALLFOLDER]com.rav.agent.json" Type="string" />
          <!-- Chrome Native Messaging (HKCU) -->
          <RegistryValue Root="HKCU" Key="SOFTWARE\Google\Chrome\NativeMessagingHosts\com.rav.agent" Value="[INSTALLFOLDER]com.rav.agent.json" Type="string" />
          
          <!-- Edge Native Messaging (HKLM) -->
          <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Edge\NativeMessagingHosts\com.rav.agent" Value="[INSTALLFOLDER]com.rav.agent.json" Type="string" />
          <!-- Edge Native Messaging (HKCU) -->
          <RegistryValue Root="HKCU" Key="SOFTWARE\Microsoft\Edge\NativeMessagingHosts\com.rav.agent" Value="[INSTALLFOLDER]com.rav.agent.json" Type="string" />

          <!-- Enterprise Policy: Force Install from Web Store -->
          <!-- Chrome -->
          <RegistryValue Root="HKLM" Key="SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist" Name="1" Value="dlkdbjmoohiplloecfgblbggpijbomna;https://clients2.google.com/service/update2/crx" Type="string" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\Policies\Google\Chrome\ExtensionInstallAllowlist" Name="1" Value="dlkdbjmoohiplloecfgblbggpijbomna" Type="string" />

          <!-- Edge -->
          <!-- Note: Edge Update URL is https://edge.microsoft.com/extensionwebstorebase/v1/crx -->
          <RegistryValue Root="HKLM" Key="SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallForcelist" Name="1" Value="epjnmnocdpicilcklecnmkmdjdegnaie;https://edge.microsoft.com/extensionwebstorebase/v1/crx" Type="string" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallAllowlist" Name="1" Value="epjnmnocdpicilcklecnmkmdjdegnaie" Type="string" />
        </Component>

        <!-- Unpacked Extension Bundle -->
        <Directory Id="ExtensionFolder" Name="extension">
          <Component Id="ExtensionSource" Guid="C3D4E5F6-A7B8-9012-CDEF-1234567890AB" Bitness="always64">
            <File Id="ExtManifest" Source="..\extension\dist\manifest.json" KeyPath="yes" />
            <File Id="ExtBackground" Source="..\extension\dist\background.js" />
            <File Id="ExtCollectors" Source="..\extension\dist\collectors.js" />
            <File Id="ExtAgentClient" Source="..\extension\dist\agent-client.js" />
            <File Id="ExtUtils" Source="..\extension\dist\utils.js" />
            <File Id="ExtTypes" Source="..\extension\dist\types.js" />
            <File Id="ExtPopupHtml" Source="..\extension\dist\popup.html" />
            <File Id="ExtPopupJs" Source="..\extension\dist\popup.js" />
          </Component>
          <Directory Id="ExtIconsFolder" Name="icons">
            <Component Id="ExtensionIcons" Guid="D4E5F6A7-B890-1234-CAD6-234567890ABC" Bitness="always64">
              <File Id="Icon16" Source="..\extension\icons\icon16.png" KeyPath="yes" />
              <File Id="Icon48" Source="..\extension\icons\icon48.png" />
              <File Id="Icon128" Source="..\extension\icons\icon128.png" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ProgramDataRAV" Name="RAV">
        <Component Id="ConfigFileComponent" Guid="B2C3D4E5-F6A7-8901-BCDE-F23456789012" Bitness="always64">
          <!-- Least-privilege permissions. The user-context Native Messaging Host must read
               config and read/write its SQLite event queue, so Users get read + write/create
               but NOT delete or change-permissions — a standard user cannot wipe the agent's
               files to evade monitoring. The agent re-applies and tightens these at runtime
               (harden_data_dir_permissions), including restricting the logs subfolder to
               Administrators + SYSTEM. The folder stays fully visible: protection, not hiding. -->
          <CreateFolder>
            <!-- CreateFile (0x2) and CreateChild (0x4) inherit to files as write-data /
                 append-data, so Users can read config + write the SQLite queue; no Delete
                 is granted, so they cannot remove the agent's files. Traverse covers
                 execute/traverse. The runtime icacls (harden_data_dir_permissions) finalizes. -->
            <util:PermissionEx User="Users"
                               Read="yes" ReadAttributes="yes" ReadExtendedAttributes="yes" ReadPermission="yes"
                               WriteAttributes="yes" WriteExtendedAttributes="yes"
                               CreateFile="yes" CreateChild="yes" Traverse="yes" Synchronize="yes" />
          </CreateFolder>
          <File Id="ConfigToml" Source="config.template.toml" Name="config.toml" KeyPath="yes" />
          <IniFile Id="WriteBackendUrl" Action="addLine" Directory="ProgramDataRAV" Name="config.toml" Section="backend" Key="url" Value="&quot;[BACKEND_URL]&quot;" />
          <IniFile Id="WriteEnrollmentToken" Action="addLine" Directory="ProgramDataRAV" Name="config.toml" Section="backend" Key="enrollment_token" Value="&quot;[ENROLLMENT_TOKEN]&quot;" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Dynamically patch the native host manifest path after files are installed -->
    <!-- This makes the MSI universal - works wherever the user installs -->
    <CustomAction Id="PatchNativeHostManifest"
                  Directory="INSTALLFOLDER"
                  ExeCommand='powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$f = &apos;[INSTALLFOLDER]com.rav.agent.json&apos;; $p = &apos;[INSTALLFOLDER]RavMonitor.exe&apos;; $j = Get-Content $f -Raw | ConvertFrom-Json; $j.path = $p; $j | ConvertTo-Json -Depth 5 | Set-Content $f"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Watchdog Scheduled Task: external health probe that runs INDEPENDENTLY
         of the main service (so it can report when the service itself is
         dead / removed). Created on install (idempotent: /f overwrites if it
         exists, e.g. on a MajorUpgrade after the old product's RemoveWatchdog
         already deleted it), removed on uninstall. -->
    <!-- Task name + binary kept in lockstep with the rename:
         "RAV Monitoring Agent Watchdog" task runs RavMonitor.exe in
         watchdog mode, every 2 minutes. If you change either string here,
         also update service/watchdog.rs (SERVICE_NAME + INSTALL_PATH_CANDIDATES).
         The install command first deletes any prior task (old and new name) so a
         rename upgrade leaves no stale task pointing at the removed old exe. -->
    <!-- Kill the user-session helper + native-host copies of the agent so they release the
         old exe before the upgrade deletes/replaces it (prevents the deferred-reboot on a
         rename upgrade). SESSION ne 0 spares the session-0 service, which ServiceControl stops
         cleanly. exit /b 0 so "no matching process" never fails the install. -->
    <CustomAction Id="KillUserSessionAgents"
                  Directory="INSTALLFOLDER"
                  ExeCommand='cmd.exe /c taskkill /F /FI "IMAGENAME eq RavMonitor.exe" /FI "SESSION ne 0" &amp; taskkill /F /FI "IMAGENAME eq AssetTelemetry.exe" /FI "SESSION ne 0" &amp; exit /b 0'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="InstallWatchdogTask"
                  Directory="INSTALLFOLDER"
                  ExeCommand='cmd.exe /c schtasks.exe /delete /tn "Asset Telemetry Watchdog" /f &amp; schtasks.exe /delete /tn "RAV Monitoring Agent Watchdog" /f &amp; schtasks.exe /create /tn "RAV Monitoring Agent Watchdog" /sc minute /mo 2 /ru SYSTEM /rl HIGHEST /tr "\"[INSTALLFOLDER]RavMonitor.exe\" --watchdog" /f'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RemoveWatchdogTask"
                  Directory="INSTALLFOLDER"
                  ExeCommand='cmd.exe /c schtasks.exe /delete /tn "RAV Monitoring Agent Watchdog" /f &amp; schtasks.exe /delete /tn "Asset Telemetry Watchdog" /f'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- (No Defender/AV custom actions. The agent is code-signed; clean install on
         Smart App Control boxes is achieved via managed Intune/GPO deployment, never
         by disabling any protection. See deployment/SIGNING-AND-CLEAN-INSTALL.md.) -->

    <Feature Id="MainFeature" Title="RAV Monitoring Agent" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ConfigFileComponent" />
      <ComponentRef Id="ExtensionSource" />
      <ComponentRef Id="ExtensionIcons" />
    </Feature>
    
  </Package>
</Wix>
